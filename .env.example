# ==============================================================================
# SKYRA CREATIONS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in Vercel Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Public Supabase URL (Used by both Frontend & Serverless Functions)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key (Safe for frontend client & user authentication)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Secret Key (CRITICAL: Used ONLY by serverless functions in api/_lib)
# NEVER expose this key in frontend code or commit to GitHub!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key


# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 OBJECT STORAGE (PRIVATE BUCKET)
# Obtain from: Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
# ------------------------------------------------------------------------------
# Cloudflare Account ID (32-character hex string)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API Token Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API Token Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of your private Cloudflare R2 bucket
R2_BUCKET_NAME=skyra-creations-private


# ------------------------------------------------------------------------------
# 3. COST & QUOTA GUIDELINES (FREE TIER FIRST)
# ------------------------------------------------------------------------------
# - Supabase Free Plan: 500 MB DB, 50,000 monthly active users, RLS enabled.
# - Cloudflare R2 Free Plan: 10 GB storage, 1M Class A ops/mo, 10M Class B ops/mo, ZERO egress fees.
# - Vercel Free Hobby / Pro: Check commercial-use requirements prior to monetization.
