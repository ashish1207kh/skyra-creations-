# ==============================================================================
# SKYRA CREATIONS — OFFICIAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For production and preview environments, configure these variables in:
# Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE (VITE / FRONTEND) VARIABLES
# These variables are prefixed with VITE_ and are safe to be bundled into the client.
# Scope: Production, Preview, Development
# ------------------------------------------------------------------------------

# Public Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (Row Level Security protected)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Domain Base URL (Used for canonical links & redirects)
VITE_SITE_URL=https://skyracreations.site


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE (VERCEL SERVERLESS FUNCTIONS ONLY)
# CRITICAL SECURITY: NEVER prefix these with VITE_ and NEVER commit actual keys to Git!
# These keys run strictly in Node.js serverless runtimes under /api
# Scope: Production, Preview, Development
# ------------------------------------------------------------------------------

# Supabase Server-Side Service Role Key (Bypasses RLS for secure admin operations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cloudflare R2 Object Storage Credentials (Private S3-compatible bucket)
# Obtain from: Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=skyra-creations-private

# Production Administrator Credentials (Fallback authentication)
ADMIN_EMAIL=admin@skyracreations.com
ADMIN_PASSWORD=SkyraDirector@Runway2026
ADMIN_JWT_SECRET=generate-a-secure-random-64-character-secret-key-here


# ------------------------------------------------------------------------------
# 3. ENVIRONMENT & INFRASTRUCTURE POLICIES
# ------------------------------------------------------------------------------
# - Supabase Free Plan: 500 MB DB, 50,000 monthly active users, RLS enforced.
# - Cloudflare R2 Free Plan: 10 GB storage, zero egress fees, private bucket.
# - Vercel Free Hobby Plan: Max 12 Serverless Functions (Skyra uses 8).
# - Vercel Custom Domains: skyracreations.site (Primary) & www.skyracreations.site (Redirect 308).
